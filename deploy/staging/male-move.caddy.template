# MALÉ MOVE staging. Install with deploy/staging/install-route.sh, which validates the whole Caddy
# config and reloads. Sign-in happens in the app: the API issues tokens only for the configured login.
staging-4.zouriel.com {
	header X-Robots-Tag "noindex, nofollow"
	header >Strict-Transport-Security "max-age=31536000"
	handle /api/* {
		reverse_proxy male-move-api:8080
	}
	handle {
		reverse_proxy male-move-web:8080
	}
}
