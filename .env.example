# Copy to .env locally. Replace every placeholder before starting the stack.
POSTGRES_DB=malemove
POSTGRES_USER=malemove_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_AUTHORITY=https://identity.example.invalid/
JWT_AUDIENCE=male-move-api
CORS_ALLOWED_ORIGINS=http://localhost:4200
PERMIT_STORAGE_PATH=/var/lib/male-move/private-permits
ALLOWED_HOSTS=localhost

